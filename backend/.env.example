DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DB_CONNECTION=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=
ZARINPAL_CURRENCY=
# A Bearer access token is sufficient for GraphQL reconciliation queries.
ZARINPAL_API_ACCESS_TOKEN=
# Optional: configure OAuth refresh credentials only for automatic token renewal.
ZARINPAL_API_CLIENT_ID=
ZARINPAL_API_CLIENT_SECRET=
ZARINPAL_API_REFRESH_TOKEN=
ZARINPAL_API_TERMINAL_ID=
ZARINPAL_RECONCILIATION_CURRENCY=IRT
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=nubixshop-signup

# Google reCAPTCHA v2 secret (paired with the frontend site key). Leave empty to
# fully disable the captcha — the risk gate no-ops and never blocks anyone.
RECAPTCHA_SECRET=
# Outbound SOCKS proxy for hosts blocked by national filtering (Resend, reCAPTCHA,
# ipinfo). Default points at the local proxy. Set empty to disable proxying.
FILTER_BYPASS_PROXY=socks5h://127.0.0.1:10808
# Risk-based captcha: only challenge after this many tokenless attempts per phone/IP
# within CAPTCHA_RISK_WINDOW seconds. SiteSetting `captcha_mode` ("off"|"always") overrides.
CAPTCHA_RISK_ATTEMPTS=3
CAPTCHA_RISK_WINDOW=900
