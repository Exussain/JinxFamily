# ============================================================
# Secrets / environment  — NEVER commit (real keys & passwords)
# ============================================================
**/.env
**/.env.local
**/.env.*.local
!**/.env.example
.certs/
*.pem
*.key
*.crt

# ============================================================
# Databases & backups — contain real customer data (PII)
# ============================================================
*.sqlite3
*.sqlite3-*
*.sqlite3.bak*
*.db

# ============================================================
# Telegram / userbot session files — these ARE credentials
# (a leaked .session grants full account access)
# ============================================================
*.session
*.session-shm
*.session-wal

# ============================================================
# AI userbot private data — memory, profiles, exported chats (PII)
# ============================================================
**/arshia_memory.json*
**/arshia_user_profiles.json*
**/*_chats.json
backend/ai-test/

# ============================================================
# Python
# ============================================================
**/__pycache__/
*.py[cod]
*.pyc
**/.venv/
.venv/
venv/
*.egg-info/

# ============================================================
# Node / Next.js
# ============================================================
**/node_modules/
**/.next/
**/out/
next-env.d.ts

# ============================================================
# Django runtime artifacts
# ============================================================
backend/media/
backend/staticfiles/

# ============================================================
# Logs & temp
# ============================================================
*.log
*.tmp

# ============================================================
# OS / editor
# ============================================================
.DS_Store
Thumbs.db
.idea/
.vscode/

# Miscellaneous feedback screenshots dropped in the repo root (not source).
# Scoped to the root so real website image assets in subfolders are unaffected.
/*.jpg

# Build caches & browser binaries
pw-browsers/
**/pw-browsers/
**/.next-build/
**/.next-prev/
chrome_user_data/
chrome_user_data_scraper/
frontend/test-results/

