{
  "$schema": "https://opencode.ai/config.json",

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 15000
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
      "timeout": 15000
    }
  },

  "plugin": [],

  "instructions": ["CLAUDE.md"],

  "lsp": true,
  "formatter": true,

  "compaction": {
    "auto": true,
    "tail_turns": 5
  }
}
