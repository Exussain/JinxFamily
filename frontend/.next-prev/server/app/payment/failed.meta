{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/payment/layout,_N_T_/payment/failed/layout,_N_T_/payment/failed/page,_N_T_/payment/failed"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/payment/failed/__PAGE__",
    "/payment/failed",
    "/payment",
    "/_index",
    "/_head"
  ]
}